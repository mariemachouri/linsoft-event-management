# ============================================================
# Notifications Service - Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs réelles
# NE COMMITEZ PAS le fichier .env dans Git
# ============================================================

# ---- MongoDB -----------------------------------------------
MONGODB_CONNECTION_STRING=mongodb://admin:admin123@localhost:27017/?authSource=admin

# ---- Keycloak ----------------------------------------------
KEYCLOAK_URL=http://localhost:8180/realms/event-mgmt
KEYCLOAK_CLIENT_SECRET=change-me

# ---- Kafka -------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================================
# EMAIL (Quarkus Mailer / SMTP)
# ============================================================
# Adresse expéditeur
EMAIL_FROM=noreply@eventmanagement.com

# --- Option 1 : Gmail (compte perso ou Google Workspace) ---
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Créez un "Mot de passe d'application" dans :
#    Mon compte → Sécurité → Connexion → Mots de passe d'appli
# 3. Utilisez ce mot de passe (16 caractères) ci-dessous
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=votre-email@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Option 2 : Mailtrap (test sans vrai envoi) ------------
# Créez un compte sur https://mailtrap.io → Inboxes → SMTP Settings
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USERNAME=<votre-user-mailtrap>
# EMAIL_PASSWORD=<votre-password-mailtrap>

# --- Option 3 : SendGrid ------------------------------------
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USERNAME=apikey
# EMAIL_PASSWORD=<votre-sendgrid-api-key>

# ============================================================
# SMS - Twilio (optionnel)
# ============================================================
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================
# PUSH - Firebase (optionnel)
# ============================================================
FIREBASE_ENABLED=false
# Chemin vers le fichier JSON des credentials Firebase
# (téléchargeable depuis Firebase Console > Paramètres du projet > Comptes de service)
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json
